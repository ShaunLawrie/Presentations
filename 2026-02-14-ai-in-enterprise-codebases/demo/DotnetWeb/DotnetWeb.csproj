<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <SpaRoot>ClientApp\</SpaRoot>
    <NoWarn>NU1900</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DotnetLibrary\DotnetLibrary.csproj" />
    
    <!-- Reference our custom analyzers -->
    <ProjectReference Include="..\Analyzers\EnterpriseAnalyzers\EnterpriseAnalyzers.csproj" 
                      OutputItemType="Analyzer" 
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <Target Name="CheckForNpm" BeforeTargets="Build">
    <!-- Check if npm is available -->
    <Exec Command="npm --version" ContinueOnError="true">
      <Output TaskParameter="ExitCode" PropertyName="NpmExitCode" />
    </Exec>
    <Error Condition="'$(NpmExitCode)' != '0'" Text="npm is not available. Please install Node.js from https://nodejs.org/" />
  </Target>

  <Target Name="NpmInstall" BeforeTargets="Build" Condition="!Exists('$(SpaRoot)node_modules')">
    <Message Importance="high" Text="Running npm install in $(SpaRoot)..." />
    <Exec WorkingDirectory="$(SpaRoot)" Command="npm install" />
  </Target>

  <Target Name="NpmBuild" BeforeTargets="Build" DependsOnTargets="NpmInstall">
    <Message Importance="high" Text="Building React frontend with npm..." />
    <Exec WorkingDirectory="$(SpaRoot)" Command="npm run build" />
  </Target>

  <Target Name="CleanSpa" AfterTargets="Clean">
    <Message Importance="high" Text="Cleaning React build output..." />
    <RemoveDir Directories="$(SpaRoot)dist;wwwroot\dist" />
  </Target>

</Project>
